{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/platform", "destination": "/platform.html" },
    { "source": "/how-it-works", "destination": "/how-it-works.html" },
    { "source": "/see-maksops", "destination": "/see-maksops.html" },
    { "source": "/get-started", "destination": "/get-started.html" },
    { "source": "/c/(.*)", "destination": "/catalogue.html" },
    { "source": "/(.*)", "destination": "/app.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
