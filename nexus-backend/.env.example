# Nexus-OP Backend — Environment Variables
# Copy this file as .env and fill in your Supabase values
# Run Spring Boot with: .\mvnw.cmd spring-boot:run

# ─── DATABASE (Supabase) ───────────────────────────────────────
# From Supabase: Project Settings → Database → Connection String → Java
# IMPORTANT: Use the "Transaction Pooler" connection (port 6543), NOT direct (port 5432)
# Direct connections don't support pgvector properly on free tier
DATABASE_URL=jdbc:postgresql://aws-0-ap-south-1.pooler.supabase.com:6543/postgres?user=postgres.YOURREF&password=YOURPASSWORD

# Or if you have PostgreSQL installed locally (no Docker):
# DATABASE_URL=jdbc:postgresql://localhost:5432/nexusop
# DB_USER=postgres
# DB_PASSWORD=yourpassword

# ─── JWT ──────────────────────────────────────────────────────
# Change this to any long random string in production
JWT_SECRET=nexusop-local-dev-secret-key-change-in-production-min-256-bits

# ─── CORS ─────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173
